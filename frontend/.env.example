# Copier en frontend/.env pour un build de production.
# En developpement ces variables sont inutiles : Vite proxifie /api et
# /socket.io vers https://localhost:8080 (voir vite.config.js).

# Service temps reel (jeu + chat), quand il n'est pas sur la meme origine que le
# frontend. Exemple une fois deploye sur Koyeb :
#   VITE_REALTIME_URL=https://ft-transcendence-realtime-xxxx.koyeb.app
VITE_REALTIME_URL=

# Backend vise par le proxy de developpement (defaut : https://localhost:8080)
VITE_DEV_BACKEND=
