# Copier en src/.env et remplir. Ne jamais versionner src/.env.

# Django
# Au moins 32 octets : en dessous, la signature HS256 des JWT est affaiblie.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DJANGO_DB_NAME=django

# En production (Neon), une seule URL remplace les quatre variables ci-dessous.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname

# Hotes HTTP acceptes par Django (liste separee par des virgules).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dossier des avatars envoyes par les utilisateurs. Doit etre persistant.
DJANGO_MEDIA_ROOT=/media

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# Jeu
WIN_SCORE=11

# Origines autorisees a ouvrir un socket (liste separee par des virgules).
# Vide = toutes, acceptable en local uniquement.
ALLOWED_ORIGINS=

# Mettre a 1 uniquement en developpement.
DJANGO_DEBUG=

# URL publique du frontend : le retour de l'OAuth 42 y renvoie le navigateur.
FRONTEND_URL=https://localhost:5173

# URL publique de cette API, telle que declaree dans l'application OAuth 42.
PUBLIC_API_URL=https://localhost:8080

# OAuth 42 — https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
